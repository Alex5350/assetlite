{
  "ConnectionStrings": {
    "AssetLite": "Data Source=assetlite.db"
  },
  "AssetLabels": {
    "PublicBaseUrl": "http://localhost:5070"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5070"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
